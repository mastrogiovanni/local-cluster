# Local Kind / Contour settings.
# Override any value on the command line, e.g. make up INGRESS_HOST=echo.local

# Hostname Contour matches on HTTPProxy (and optional TLS certificate).
INGRESS_HOST=mastrogiovanni.ddns.net

# Let's Encrypt account email (required for `make cert`). Use a real inbox.
ACME_EMAIL=michele.mastrogiovanni@gmail.com

# OCR GPU for Kind / device plugin (auto-detected RTX 4060 family if unset).
GPU_DEVICE_UUID=GPU-2ea93ea1-3f77-449c-8915-1f1733c7e598
